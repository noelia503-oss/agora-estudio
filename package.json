{
  "name": "estudio-oposicion-policial",
  "description": "Aplicación local de estudio para oposición policial.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --mac dmg"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "heic-to": "^1.5.2",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "es.agora.estudio",
    "productName": "Ágora",
    "asar": true,
    "files": ["dist/**/*", "electron/main.cjs", "build/icon.png", "package.json"],
    "directories": { "buildResources": "build", "output": "release" },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "target": ["dmg"]
    },
    "electronFuses": {
      "enableCookieEncryption": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "dmg": {
      "artifactName": "Agora-${version}-${arch}.${ext}"
    }
  }
}
